# ==============================================================================
# SupplyChain AI Control Tower — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your environment-specific credentials.
# NEVER commit your real .env file or credentials to version control.

# Application Environment Settings
ENVIRONMENT=development               # Options: development, staging, production
DEBUG=false                           # Options: true, false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO                        # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Frontend & CORS Configuration (Comma-separated list of allowed origins)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# PostgreSQL Database Connection String (REQUIRED)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/supply_chain_ai

# ==============================================================================
# External Disruption Telemetry Providers (Optional / Fallback-Enabled)
# When API keys are omitted or providers are unreachable, the system will
# automatically engage safe deterministic mock telemetry fallback without crashing.
# ==============================================================================

# General External Provider Timeouts & Resilience
EXTERNAL_DATA_TIMEOUT_SECONDS=5.0
ENABLE_MOCK_FALLBACK=true

# 1. Weather Telemetry Provider (Default: Open-Meteo live API or mock)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# 2. Port Congestion & AIS Maritime Telemetry (Default: PortWatch live API or mock)
PORT_PROVIDER=portwatch
PORT_API_KEY=
PORT_API_URL=https://portwatch.imf.org/api/v1

# 3. Highway & Rail Freight Flow Telemetry (Default: OpenFreight live API or mock)
TRAFFIC_PROVIDER=openfreight
TRAFFIC_API_KEY=
TRAFFIC_API_URL=https://api.openfreight.org/v1


