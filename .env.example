# ==============================================================================
# SupplyChain AI Control Tower — Environment Configuration Template
# ==============================================================================

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws

# --- Backend Application Settings ---
APP_NAME="SupplyChain AI Control Tower"
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- PostgreSQL Database Configuration ---
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgre1@localhost:5432/supply_chain_ai

# --- Redis Caching & Resilient Fallback Layer (Phase 7) ---
# When REDIS_ENABLED=true, the application uses Redis for high-frequency telemetry
# and route calculation caching. If Redis is unavailable, it automatically falls
# back to an in-memory TTL cache with zero downtime or crash.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=1.5
REDIS_DEFAULT_TTL=300
REDIS_TELEMETRY_TTL=60
REDIS_ROUTE_CACHE_TTL=120

# --- External Disruption Telemetry Providers (Phase 6) ---
EXTERNAL_DATA_TIMEOUT_SECONDS=5.0
ENABLE_MOCK_FALLBACK=true

WEATHER_PROVIDER=open-meteo
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

PORT_PROVIDER=portwatch
PORT_API_URL=https://portwatch.imf.org/api/v1
PORT_API_KEY=

TRAFFIC_PROVIDER=openfreight
TRAFFIC_API_URL=https://api.openfreight.org/v1
TRAFFIC_API_KEY=
